# Port the server listens on
PORT=3000

# Path to the yt-dlp binary (default: yt-dlp from PATH)
YTDLP_BIN=yt-dlp

# Folder containing ffmpeg and ffprobe, only if they are not on PATH
FFMPEG_LOCATION=

# Netscape cookies file. Needed for some Instagram content and when YouTube
# asks the server to confirm it is not a bot. Use a throwaway account.
YTDLP_COOKIES=

# Optional outbound proxy, for example http://user:pass@host:port
YTDLP_PROXY=

# Largest file the server will create, for example 2G. Empty means no limit.
MAX_FILESIZE=

# Maximum yt-dlp jobs running at once
MAX_JOBS=3

# Set to 1 when running behind one reverse proxy (Caddy, nginx, a platform load balancer)
# so rate limiting uses the real visitor IP.
TRUST_PROXY=1